# Copy to .env and fill in only the providers you've actually switched on in
# a project's project.yaml — everything defaults to local/free adapters.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TAVILY_API_KEY=
GOOGLE_CSE_API_KEY=
ELEVENLABS_API_KEY=
GOOGLE_TTS_API_KEY=
YOUTUBE_CLIENT_SECRET_PATH=

# Key for any provider using vendor "custom" (openai_compatible.py) — a
# self-hosted OpenAI-compatible router such as 9router, LiteLLM, vLLM, etc.
# The variable name here is whatever you set as providers.<cap>.options.api_key_env
# in project.yaml — NINEROUTER_API_KEY is just this repo's own local example.
NINEROUTER_API_KEY=
